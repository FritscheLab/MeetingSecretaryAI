{
    "type": "object",
    "properties": {
        "meetingTitle": {
            "type": "string",
            "description": "The title of the meeting"
        },
        "meetingDate": {
            "type": "string",
            "description": "The date of the meeting in YYYYMMDD format (e.g., 20250415)"
        },
        "agendaItems": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "description": "Title of the agenda item"
                    },
                    "startTimestamp": {
                        "type": "string",
                        "description": "The timestamp when this agenda item started being discussed (HH:MM:SS format)"
                    },
                    "endTimestamp": {
                        "type": "string",
                        "description": "The timestamp when this agenda item finished being discussed (HH:MM:SS format)"
                    },
                    "summary": {
                        "type": "string",
                        "description": "A brief summary of what was discussed during this agenda item"
                    }
                },
                "required": ["title", "startTimestamp", "endTimestamp", "summary"],
                "additionalProperties": false
            }
        },
        "next_meeting": {
            "type": "object",
            "properties": {
                "date": { "type": "string", "description": "Date of the next meeting in YYYYMMDD format (e.g., 20250430)" },
                "time": { "type": "string", "description": "Time of the next meeting in 12-hour format (e.g., '1:00 PM')" },
                "location": { "type": "string", "description": "Location of the next meeting" }
            },
            "required": ["date", "time", "location"],
            "additionalProperties": false
        },
        "adjournment": {
            "type": "object",
            "properties": {
                "time": { "type": "string", "description": "Time when the meeting was adjourned in 12-hour format (e.g., '3:30 PM')" }
            },
            "required": ["time"],
            "additionalProperties": false
        }
    },
    "required": ["meetingTitle", "meetingDate", "agendaItems", "next_meeting", "adjournment"],
    "additionalProperties": false
}
